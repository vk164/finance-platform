#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' '*.pyi')

if (( ${#files[@]} > 0 )); then
    uv run ruff check --fix --exit-non-zero-on-fix -- "${files[@]}"
fi

uv run python -m pyright
